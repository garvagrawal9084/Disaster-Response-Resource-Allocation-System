        <mxCell id="6" value="docker compose exec database psql -U drras -d drras" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F8FB;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="118" width="1480" height="46" as="geometry" />
        </mxCell>
        <mxCell id="7" value="In psql, run \dt to list tables and \d travel_matrix to inspect one. Try:" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="178" width="1480" height="48" as="geometry" />
        </mxCell>
        <mxCell id="8" value="SELECT postgis_version();&#10;SELECT name, region, revision FROM scenarios;&#10;SELECT scenario_id, revision, method, runtime_ms FROM runs ORDER BY created_at DESC;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F8FB;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="1480" height="91" as="geometry" />
        </mxCell>
        <mxCell id="9" value="To export a backup, run docker compose exec -T database pg_dump -U drras -d drras &amp;gt; drras-backup.sql from the repository root. Save that file somewhere you can find later." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
