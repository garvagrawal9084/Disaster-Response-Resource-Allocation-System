        <mxCell id="6" value="Project: Disaster Response Resource Allocation System (DRRAS)   Design baseline: Repository commit 8591467, reviewed 17 November 2026   Scope: Implemented browser-based planning prototype for simulated ambulance allocation." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="118" width="1480" height="71" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="099f4d555c30" name="1 Purpose and design basis">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="960" as="geometry" />
        </mxCell>
        <mxCell id="3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#173B60;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="76" as="geometry" />
        </mxCell>
        <mxCell id="4" value="1 Purpose and design basis" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=27;fontColor=#FFFFFF;fontStyle=1;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="15" width="1470" height="47" as="geometry" />
        </mxCell>
        <mxCell id="5" value="DRRAS Software Design Documents  |  Page 2" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#526579;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="907" width="1450" height="25" as="geometry" />
        </mxCell>
        <mxCell id="6" value="This document describes the implemented layered architecture and two representative use-case interactions: adding an affected area and running an allocation. Each interaction has a time-ordered sequence diagram and an equivalent object-link collaboration diagram. The coordinator reviews proposed assignments; the system does not dispatch vehicles." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="118" width="1480" height="71" as="geometry" />
        </mxCell>
        <mxCell id="7" value="The design follows the project SRS (../Document/DRRAS_SRS.pdf), use-case report (../Document/Disaster_Response_Use_Case_Report%20Final.pdf), and DFD (../Document/Data%20Flow%20Diagram.pdf). The DFD names D1 Scenario Data, D2 Travel-Time Matrix, and D3 Allocation Results. The prescribed textbook is *Software Engineering* by Prof. Salman Abdul Moiz (AICTE, 2024), Unit 3. Section 3.4.2 and Figure 3.6 (printed p. 78, PDF p. 102) describe horizontal layers and their services. Section 3.6.1 and Figures 3.12-3.13 (printed pp. 84-85, PDF pp. 108-109) define sequence diagrams as message order over time and collaboration diagrams as direct object links with messages. These figures are guidance for notation; the diagrams below model DRRAS itself." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="203" width="1480" height="142" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
