        </mxCell>
        <mxCell id="4" value="2 Layered architecture" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=27;fontColor=#FFFFFF;fontStyle=1;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="15" width="1470" height="47" as="geometry" />
        </mxCell>
        <mxCell id="5" value="DRRAS Software Design Documents  |  Page 3" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#526579;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="907" width="1450" height="25" as="geometry" />
        </mxCell>
        <mxCell id="6" value="Figure 1. Implemented four-layer view. The vertical arrows show service requests from a higher layer to a lower one; responses travel back upward. OSRM and OpenStreetMap are external services, not database tables." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="118" width="1480" height="71" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
