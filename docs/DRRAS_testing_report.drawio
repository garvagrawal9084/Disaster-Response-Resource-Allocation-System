  <diagram id="4eec57eb895c" name="4 Methodology and procedure">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="960" as="geometry" />
        </mxCell>
        <mxCell id="3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#173B60;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="76" as="geometry" />
        </mxCell>
        <mxCell id="4" value="4 Methodology and procedure" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=27;fontColor=#FFFFFF;fontStyle=1;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="15" width="1470" height="47" as="geometry" />
        </mxCell>
        <mxCell id="5" value="DRRAS Software Testing Report  |  Page 5" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#526579;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="907" width="1450" height="25" as="geometry" />
        </mxCell>
        <mxCell id="6" value="Requirements analysis: derive expected behavior from Document/DRRAS_SRS.pdf, its use cases and user stories. Planning: separate source-aware unit checks from external behavior checks and define a fresh test scenario. Design: select normal, invalid, boundary, zero-demand, shortage, routing-fallback, revision, and persistence cases. Environment: record commit, tools, settings, and sample data. Execution: run each case, capture observed output, compare it with the oracle, and note defects. Closure: rerun failures after fixes, preserve evidence, and sign only when all required cases have actual results." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="118" width="1480" height="119" as="geometry" />
        </mxCell>
        <mxCell id="7" value="White box cases use pytest assertions as oracles. They directly exercise allocation.py, routing.py, and Pydantic models in models.py; OSRM responses are stubbed only in W21. Branch coverage was measured with coverage.py. Black box cases are defined from the API and UI contract and must be executed against the Compose stack without consulting the implementation for expected behavior. They are primarily system and integration tests; Garv should use the SRS and visible/API responses as the oracle. No customer acceptance test has been performed." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="251" width="1480" height="119" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
