        <mxCell id="5" value="DRRAS Software Testing Report  |  Page 2" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#526579;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="907" width="1450" height="25" as="geometry" />
        </mxCell>
        <mxCell id="6" value="This internal report records Pratibha Yadav&amp;#x27;s W01-W27 execution on 18 November 2026 and an earlier proposed black box suite B01-B22. The professor-facing DRRAS Software Testing Report in Document has the current combined case record. Garv Agrawal reported a separate BB-01–BB-24 suite on 17 November; his raw JSON files are to be attached. A Pass means an observed result matched its expected result. Pending means no actual result was recorded for that specific planned case ID." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="118" width="1480" height="119" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="d252145b2f37" name="2 Textbook alignment">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="960" as="geometry" />
        </mxCell>
        <mxCell id="3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#173B60;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="76" as="geometry" />
        </mxCell>
        <mxCell id="4" value="2 Textbook alignment" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=27;fontColor=#FFFFFF;fontStyle=1;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="15" width="1470" height="47" as="geometry" />
        </mxCell>
        <mxCell id="5" value="DRRAS Software Testing Report  |  Page 3" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#526579;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="907" width="1450" height="25" as="geometry" />
        </mxCell>
        <mxCell id="6" value="The prescribed textbook is *Software Engineering* by Prof. Salman Abdul Moiz, AICTE, February 2024 (C:\Studies\Sem_III\Software_Engineering\SoftwareEngineering (4th SEM)-Final_watermark.pdf). Unit 4, printed pp. 108-129 (PDF pp. 132-153), defines the test oracle, testing process, black box and white box techniques, and unit, integration, system, and acceptance levels. Figure 4.3 on printed p. 112 gives the case record fields Test ID, Task, Expected Result, Actual Result, Status. This report uses those fields. Black box cases use equivalence classes, boundary values, and condition/action combinations from §§4.3.1-4.3.4. White box cases target internal branches and functions as in §§4.4.1-4.4.4. The reported coverage is measured statement/branch coverage, not full path coverage. The current architecture description uses the D1/D2/D3 data-store and process concepts from the project SRS and DFDs, consistent with the book&amp;#x27;s requirements and design chapters." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="118" width="1480" height="166" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
