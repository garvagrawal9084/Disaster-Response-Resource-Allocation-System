        <mxCell id="10" value="White Box Testing: inspect source, repeat the 27 tests, examine uncovered branches, approve or log defects." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="166" width="620" height="56" as="geometry" />
        </mxCell>
        <mxCell id="11" value="Ran W01-W27 on 18 November 2026: 27 passed; 96% measured coverage of selected modules. Source review and sign-off pending." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="910" y="166" width="630" height="56" as="geometry" />
        </mxCell>
        <mxCell id="12" value="Garv Agrawal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="222" width="230" height="56" as="geometry" />
        </mxCell>
        <mxCell id="13" value="Black Box Testing: use the application/API against requirements without using source behavior as the oracle; record actual results and evidence." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="222" width="620" height="56" as="geometry" />
        </mxCell>
        <mxCell id="14" value="Reported BB-01–BB-24: 24 passed on 17 November 2026. Raw machine results and screenshots to be attached by Garv." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="910" y="222" width="630" height="56" as="geometry" />
        </mxCell>
        <mxCell id="15" value="The textbook prefers testing independent of development to reduce bias. Both team members contributed code, so the report discloses that limitation. A teacher or another reviewer can independently review the results." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
