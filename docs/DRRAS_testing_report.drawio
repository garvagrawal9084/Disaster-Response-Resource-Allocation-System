        <mxCell id="5" value="DRRAS Software Testing Report  |  Page 6" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#526579;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="907" width="1450" height="25" as="geometry" />
        </mxCell>
        <mxCell id="6" value="- Pratibha&amp;#x27;s 18 November run: Windows; Python 3.12.14 virtual environment; pytest 9.2.0; coverage 7.17.3; commit 8591467." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="118" width="1480" height="46" as="geometry" />
        </mxCell>
        <mxCell id="7" value="- npm run build passed with Vite 6.4.6, producing static frontend assets. Python compileall passed. These are build/syntax checks, not functional acceptance tests." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="178" width="1480" height="46" as="geometry" />
        </mxCell>
        <mxCell id="8" value="- Docker CLI was present, but the Docker Desktop Linux engine was unavailable. Thus current database, API, frontend integration, restart persistence, live OSRM, and manual browser cases were not rerun." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="238" width="1480" height="68" as="geometry" />
        </mxCell>
        <mxCell id="9" value="- Test source: ../tests/test_white_box.py. Pratibha&amp;#x27;s JUnit record: evidence/pratibha_white_box_junit.xml. Coverage: evidence/pratibha_coverage.json. The earlier preliminary files remain in evidence/ for traceability." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="321" width="1480" height="68" as="geometry" />
        </mxCell>
        <mxCell id="10" value="- To repeat from the repository root after installing backend/requirements.txt, pytest, and coverage: python -m coverage run --branch --source=backend.app.allocation,backend.app.routing,backend.app.models -m pytest -v tests/test_white_box.py, then python -m coverage report -m." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="403" width="1480" height="68" as="geometry" />
        </mxCell>
