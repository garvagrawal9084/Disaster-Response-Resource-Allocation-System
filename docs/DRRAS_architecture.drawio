<mxfile host="app.diagrams.net" agent="DRRAS documentation" version="24.7.17" type="device" pages="1">
  <diagram id="b2b1deeb9776" name="Overview">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="960" as="geometry" />
        </mxCell>
        <mxCell id="3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#173B60;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="76" as="geometry" />
        </mxCell>
        <mxCell id="4" value="Overview" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=27;fontColor=#FFFFFF;fontStyle=1;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="15" width="1470" height="47" as="geometry" />
        </mxCell>
        <mxCell id="5" value="Architecture and data flow  |  Page 1" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#526579;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="907" width="1450" height="25" as="geometry" />
        </mxCell>
        <mxCell id="6" value="The browser dashboard uses React and Leaflet. It sends JSON over HTTP to FastAPI through Nginx in Docker, or through Vite during frontend development. FastAPI uses Psycopg to query PostgreSQL/PostGIS. The backend calls OSRM for road travel estimates and uses OR-Tools for the optimized allocation." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="118" width="1480" height="71" as="geometry" />
        </mxCell>
        <mxCell id="7" value="1. Scenario data (D1). The API validates and persists areas, bases, and ambulance stock. Leaflet reads their coordinates from the scenario response and requests background tiles from OpenStreetMap." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="203" width="1480" height="68" as="geometry" />
        </mxCell>
        <mxCell id="8" value="2. Travel-time matrix (D2). The first allocation at a scenario revision loads pairwise road times from OSRM, fills gaps with flagged estimates, and saves the matrix. Both methods use those same rows." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="286" width="1480" height="68" as="geometry" />
        </mxCell>
        <mxCell id="9" value="3. Allocation results (D3). A run evaluates the current revision independently. It saves the input snapshot, method, assignments, metrics, and runtime. The dashboard reads the latest run for each method at the current revision and computes the display differences." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="368" width="1480" height="68" as="geometry" />
        </mxCell>
        <mxCell id="10" value="The three stores share one database. Scenario revisions keep changed inputs and older results distinguishable. The PostGIS points are the persisted coordinates. The Leaflet assignment links visualize endpoints, and the matrix stores travel durations and distances." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="451" width="1480" height="71" as="geometry" />
        </mxCell>
        <mxCell id="11" value="See the backend walkthrough (DRRAS_backend.drawio) for table relationships, transaction boundaries, and implementation details. The SRS (../Document/DRRAS_SRS.pdf) defines the coursework requirements." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="536" width="1480" height="71" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>