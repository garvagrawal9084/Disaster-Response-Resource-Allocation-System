        </mxCell>
        <mxCell id="6" value="- Added React/TypeScript/Vite dashboard with scenario forms, Leaflet map, browser-local sample data, illustrative allocation previews, metrics, and comparison. See DRRAS_frontend.drawio (DRRAS_frontend.drawio)." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="118" width="1480" height="68" as="geometry" />
        </mxCell>
        <mxCell id="7" value="- Added a production build served by Nginx and a frontend-only Compose service. See DRRAS_docker.drawio (DRRAS_docker.drawio)." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
