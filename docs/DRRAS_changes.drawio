        <mxCell id="2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="960" as="geometry" />
        </mxCell>
        <mxCell id="3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#173B60;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="76" as="geometry" />
        </mxCell>
        <mxCell id="4" value="2026-11-11 — Persistent backend and allocation" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=27;fontColor=#FFFFFF;fontStyle=1;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="15" width="1470" height="47" as="geometry" />
        </mxCell>
        <mxCell id="5" value="Implementation change log  |  Page 5" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#526579;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="907" width="1450" height="25" as="geometry" />
        </mxCell>
        <mxCell id="6" value="- Added FastAPI, PostgreSQL/PostGIS, startup migrations, and the eight application tables for scenarios, travel times, and results. The dashboard saves inputs to the API and can import custom scenarios from the former browser prototype." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="118" width="1480" height="68" as="geometry" />
        </mxCell>
        <mxCell id="7" value="- Added OSRM matrix routing, a straight-line fallback, the severity-first baseline, and OR-Tools minimum-cost flow. Both methods share one matrix per scenario revision and persist their assignments, metrics, and runtime. Scenario edits retain historical runs and their input snapshots." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="1480" height="68" as="geometry" />
        </mxCell>
        <mxCell id="8" value="- Updated Docker Compose and the Nginx and Vite proxies. Documented the schema, endpoints, formulas, design decisions, demo steps, and maintenance in the backend walkthrough (DRRAS_backend.drawio)." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="283" width="1480" height="68" as="geometry" />
        </mxCell>
        <mxCell id="9" value="- Verified the TypeScript production build, Compose startup, live OSRM and forced fallback on all three samples, concurrent runs, validation, legacy import, and saved results after restarting the database and API. Opened the saved comparison in the browser." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="365" width="1480" height="68" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
