        <mxCell id="17" value="resource_bases" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="324" width="620" height="48" as="geometry" />
        </mxCell>
        <mxCell id="18" value="A base with a map location" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="910" y="324" width="630" height="48" as="geometry" />
        </mxCell>
        <mxCell id="19" value="D1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="372" width="230" height="48" as="geometry" />
        </mxCell>
        <mxCell id="20" value="resources" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="372" width="620" height="48" as="geometry" />
        </mxCell>
        <mxCell id="21" value="The number of ambulances available at one base" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="910" y="372" width="630" height="48" as="geometry" />
        </mxCell>
        <mxCell id="22" value="D2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="230" height="56" as="geometry" />
        </mxCell>
        <mxCell id="23" value="travel_matrix" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="420" width="620" height="56" as="geometry" />
        </mxCell>
        <mxCell id="24" value="Time in seconds, distance in meters, and fallback status for one pair at one revision" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="910" y="420" width="630" height="56" as="geometry" />
        </mxCell>
        <mxCell id="25" value="D3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="476" width="230" height="56" as="geometry" />
        </mxCell>
        <mxCell id="26" value="runs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="476" width="620" height="56" as="geometry" />
        </mxCell>
        <mxCell id="27" value="One allocation execution, its method and runtime, the input snapshot, and solver settings" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="910" y="476" width="630" height="56" as="geometry" />
        </mxCell>
        <mxCell id="28" value="D3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="532" width="230" height="48" as="geometry" />
        </mxCell>
        <mxCell id="29" value="allocations" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="532" width="620" height="48" as="geometry" />
        </mxCell>
        <mxCell id="30" value="The positive quantity one run assigns from one base to one area" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="910" y="532" width="630" height="48" as="geometry" />
        </mxCell>
        <mxCell id="31" value="D3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="230" height="48" as="geometry" />
        </mxCell>
        <mxCell id="32" value="metrics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="290" y="580" width="620" height="48" as="geometry" />
        </mxCell>
        <mxCell id="33" value="The six allocation quality measures for one run" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="910" y="580" width="630" height="48" as="geometry" />
        </mxCell>
        <mxCell id="34" value="Locations use geometry(Point, 4326). The browser sends { &amp;quot;lat&amp;quot;: ..., &amp;quot;lng&amp;quot;: ... }. PostGIS stores a point in longitude, latitude order, so the repository calls ST_MakePoint(lng, lat) and reads it back with ST_X and ST_Y." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="644" width="1480" height="71" as="geometry" />
        </mxCell>
        <mxCell id="35" value="A matrix row is keyed by scenario, revision, base, and area. An allocation references a run and a matrix row for that same scenario and revision. Database checks enforce allowed severity, valid coordinate ranges, and positive or nonnegative quantities where appropriate. The backend validates each complete plan before saving, including totals per base and per area. Those totals span several rows, so they are checked together in validate_assignments." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="729" width="1480" height="95" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="033b8cda42ee" name="Database design cont">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="960" as="geometry" />
        </mxCell>
        <mxCell id="3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#173B60;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="76" as="geometry" />
        </mxCell>
        <mxCell id="4" value="Database design (continued)" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=27;fontColor=#FFFFFF;fontStyle=1;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="15" width="1470" height="47" as="geometry" />
        </mxCell>
        <mxCell id="5" value="Backend and database walkthrough  |  Page 5" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#526579;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="907" width="1450" height="25" as="geometry" />
        </mxCell>
        <mxCell id="6" value="Adding or removing a location increments the scenario revision. Removal marks the location inactive so historical foreign keys remain valid. A run also stores a JSON copy of the scenario inputs. That snapshot preserves the names, coordinates, quantities, and severity used by the run even if a sample is restored later. The comparison screen selects the latest saved run for each method at the current revision. Earlier revisions remain accessible through the history endpoints." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="118" width="1480" height="95" as="geometry" />
        </mxCell>
        <mxCell id="7" value="Scenario edits and allocation runs lock their scenario row in a database transaction. This ensures two requests for the same scenario agree on which revision they are using and prevents simultaneous runs from creating competing matrices. A matrix, a run, its assignments, and metrics are committed together when a new matrix is needed. An error rolls that transaction back. The planner copies the stock into its own calculations, so a proposed assignment does not change stored inventory." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="227" width="1480" height="95" as="geometry" />
        </mxCell>
        <mxCell id="8" value="On startup, FastAPI applies the SQL files in filename order. The schema_migrations table records which migrations ran successfully, and a PostgreSQL advisory lock prevents two startup processes from applying the same migration simultaneously. Startup inserts missing built-in samples and keeps previously saved ones." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="336" width="1480" height="71" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="30838f67fdf8" name="API reference">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="960" as="geometry" />
        </mxCell>
        <mxCell id="3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#173B60;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="76" as="geometry" />
        </mxCell>
        <mxCell id="4" value="API reference" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=27;fontColor=#FFFFFF;fontStyle=1;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="15" width="1470" height="47" as="geometry" />
        </mxCell>
        <mxCell id="5" value="Backend and database walkthrough  |  Page 6" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#526579;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="907" width="1450" height="25" as="geometry" />
        </mxCell>
        <mxCell id="6" value="All paths below start with /api. Swagger UI at &amp;lt;http://localhost:8080/api/docs&amp;gt; lets you inspect input schemas and call endpoints from the browser." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="118" width="1480" height="48" as="geometry" />
        </mxCell>
        <mxCell id="7" value="Method and path" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#173B60;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#FFFFFF;fontFamily=Arial;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="8" value="Request or result" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#173B60;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#FFFFFF;fontFamily=Arial;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="180" width="1080" height="48" as="geometry" />
        </mxCell>
        <mxCell id="9" value="GET /health" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="228" width="400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="10" value="Confirms the API can query PostgreSQL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="228" width="1080" height="48" as="geometry" />
        </mxCell>
        <mxCell id="11" value="GET /scenarios" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="276" width="400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="12" value="Lists scenarios with their active areas, bases, and revisions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="276" width="1080" height="48" as="geometry" />
        </mxCell>
        <mxCell id="13" value="POST /scenarios" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="324" width="400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="14" value="Accepts name, region, and optional description" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="324" width="1080" height="48" as="geometry" />
        </mxCell>
        <mxCell id="15" value="GET /scenarios/{id}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="372" width="400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="16" value="Returns one current scenario" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="372" width="1080" height="48" as="geometry" />
        </mxCell>
        <mxCell id="17" value="POST /scenarios/{id}/areas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="18" value="Accepts name, location, population, severity, and demand" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="420" width="1080" height="48" as="geometry" />
        </mxCell>
        <mxCell id="19" value="POST /scenarios/{id}/bases" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="468" width="400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="20" value="Accepts name, location, and quantity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="468" width="1080" height="48" as="geometry" />
        </mxCell>
        <mxCell id="21" value="DELETE /scenarios/{id}/areas/{areaId}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="516" width="400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="22" value="Removes an area from the current scenario and returns the updated scenario" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="516" width="1080" height="48" as="geometry" />
        </mxCell>
        <mxCell id="23" value="DELETE /scenarios/{id}/bases/{baseId}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="564" width="400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="24" value="Removes a base from the current scenario and returns the updated scenario" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="564" width="1080" height="48" as="geometry" />
        </mxCell>
        <mxCell id="25" value="POST /scenarios/restore-samples" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="612" width="400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="26" value="Restores the three built-in scenarios, with custom scenarios and saved runs retained" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="612" width="1080" height="48" as="geometry" />
        </mxCell>
        <mxCell id="27" value="POST /scenarios/import" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="400" height="56" as="geometry" />
        </mxCell>
        <mxCell id="28" value="Imports a custom scenario from the former browser prototype. Accepts its id, scenario fields, and arrays of area and base inputs. The original ID makes repeated imports return the same database scenario." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="660" width="1080" height="56" as="geometry" />
        </mxCell>
        <mxCell id="29" value="GET /scenarios/{id}/matrix" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="716" width="400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="30" value="Returns the saved pair list, empty until the first run. Pass ?revision=N to inspect a historical matrix." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="716" width="1080" height="48" as="geometry" />
        </mxCell>
        <mxCell id="31" value="POST /scenarios/{id}/runs/baseline" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="764" width="400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="32" value="Runs and saves the baseline, returning assignments and metrics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="764" width="1080" height="48" as="geometry" />
        </mxCell>
        <mxCell id="33" value="POST /scenarios/{id}/runs/optimized" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="812" width="400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="34" value="Runs and saves the optimizer, returning assignments and metrics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="812" width="1080" height="48" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="fa6ef95acfd4" name="API reference cont">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="960" as="geometry" />
        </mxCell>
        <mxCell id="3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#173B60;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="76" as="geometry" />
        </mxCell>
        <mxCell id="4" value="API reference (continued)" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=27;fontColor=#FFFFFF;fontStyle=1;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="15" width="1470" height="47" as="geometry" />
        </mxCell>
        <mxCell id="5" value="Backend and database walkthrough  |  Page 7" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#526579;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="907" width="1450" height="25" as="geometry" />
        </mxCell>
        <mxCell id="6" value="Method and path" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#173B60;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#FFFFFF;fontFamily=Arial;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="118" width="400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="7" value="Request or result" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#173B60;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#FFFFFF;fontFamily=Arial;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="118" width="1080" height="48" as="geometry" />
        </mxCell>
        <mxCell id="8" value="GET /scenarios/{id}/runs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="166" width="400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="9" value="Returns the current revision and its latest saved run for each method" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="166" width="1080" height="48" as="geometry" />
        </mxCell>
        <mxCell id="10" value="GET /scenarios/{id}/runs/history" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="214" width="400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="11" value="Lists historical runs, newest first. Supports limit and offset." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="214" width="1080" height="48" as="geometry" />
        </mxCell>
        <mxCell id="12" value="GET /scenarios/{id}/runs/{runId}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="262" width="400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="13" value="Returns one saved run with its original scenario snapshot" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="262" width="1080" height="48" as="geometry" />
        </mxCell>
        <mxCell id="14" value="The API returns HTTP 404 for unknown scenarios or locations and HTTP 422 for invalid inputs or a run without both areas and bases. Each scenario accepts up to 40 active areas and 40 active bases so a single OSRM request contains at most 80 points. Demand and stock are integers from 0 through 1,000,000. Both bounds can be found in models.py. Database connection failures return HTTP 503 when the API is running and can detect the failure." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="326" width="1480" height="95" as="geometry" />
        </mxCell>
        <mxCell id="15" value="Try the baseline using the Hyderabad sample:" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="435" width="1480" height="48" as="geometry" />
        </mxCell>
        <mxCell id="16" value="curl -X POST http://localhost:8080/api/scenarios/musi-flood/runs/baseline&#10;curl http://localhost:8080/api/scenarios/musi-flood/matrix&#10;curl -X POST http://localhost:8080/api/scenarios/musi-flood/runs/optimized&#10;curl http://localhost:8080/api/scenarios/musi-flood/runs" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F8FB;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="497" width="1480" height="113" as="geometry" />
        </mxCell>
        <mxCell id="17" value="Each assignment contains baseId, areaId, quantity, travelMinutes, and isFallback. The run&amp;#x27;s usesFallback reports whether its matrix contains any estimated pair, including pairs that the plan did not use." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="624" width="1480" height="71" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="3f56638863b4" name="Routing">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="960" as="geometry" />
        </mxCell>
        <mxCell id="3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#173B60;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="76" as="geometry" />
        </mxCell>
        <mxCell id="4" value="Routing" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=27;fontColor=#FFFFFF;fontStyle=1;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="15" width="1470" height="47" as="geometry" />
        </mxCell>
        <mxCell id="5" value="Backend and database walkthrough  |  Page 8" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#526579;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="907" width="1450" height="25" as="geometry" />
        </mxCell>
        <mxCell id="6" value="The routing service sends base coordinates as sources and area coordinates as destinations in one request. The result is directional, from a base to an area. The backend rounds durations to whole seconds and stores distances in meters. An unavailable endpoint, unusable response, or missing pair uses the Haversine great-circle distance. The fallback time is distance divided by a constant speed, 30 km/h by default. That value is a project modeling assumption. The dashed map lines connect the assigned endpoints. Road travel times and distances come from the matrix. OSRM Table API (https://project-osrm.org/docs/v5.24.0/api/#table-service)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="118" width="1480" height="119" as="geometry" />
        </mxCell>
        <mxCell id="7" value="Once saved, the matrix is reused for the life of that scenario revision, including fallback pairs. This lets a comparison use identical inputs even if OSRM becomes available between runs. An input change creates a fresh revision and the next allocation creates its new matrix." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="251" width="1480" height="71" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="26b4e6d0e4b5" name="How the two allocation methods work">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="960" as="geometry" />
        </mxCell>
        <mxCell id="3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#173B60;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="76" as="geometry" />
        </mxCell>
        <mxCell id="4" value="How the two allocation methods work" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=27;fontColor=#FFFFFF;fontStyle=1;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="15" width="1470" height="47" as="geometry" />
        </mxCell>
        <mxCell id="5" value="Backend and database walkthrough  |  Page 9" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#526579;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="907" width="1450" height="25" as="geometry" />
        </mxCell>
        <mxCell id="6" value="Baseline. Visit the areas in severity order: Critical, High, Medium, Low. For each area, sort the bases by travel time and send as many units as possible from each base until the area is served or all stock is used. For equal severity or travel times, sort by the corresponding record ID so a repeated run gets the same ordering. This method is easy to explain and prioritizes severe areas. An early decision can use stock that would have reduced travel elsewhere." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="118" width="1480" height="95" as="geometry" />
        </mxCell>
        <mxCell id="7" value="Optimizer. OR-Tools solves a minimum-cost flow problem. A source represents the total number of units demanded. Source-to-base arcs have capacities equal to base stock. Base-to-area arcs have a per-unit cost equal to the travel time in seconds. Each area must receive flow equal to its demand. A direct arc from the source to each area represents unmet demand and costs 7,200 per missing unit by default. Flow through that direct arc becomes unmet demand in the metrics. Only base-to-area flow becomes an ambulance assignment. The solver returns whole units and the backend validates the resulting plan independently. OR-Tools minimum-cost flow (https://developers.google.com/optimization/flow/mincostflow)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="227" width="1480" height="142" as="geometry" />
        </mxCell>
        <mxCell id="8" value="The objective, in seconds, is:" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="383" width="1480" height="48" as="geometry" />
        </mxCell>
        <mxCell id="9" value="sum(assigned units × travel seconds) + unmet units × penalty seconds" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F5F8FB;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=15;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="445" width="1480" height="46" as="geometry" />
        </mxCell>
        <mxCell id="10" value="The penalty gives a cost to leaving demand uncovered. For example, with two areas demanding one ambulance each and one ambulance available, the baseline sends it to the Critical area even if it is farther away. If both routes cost less than the penalty, the optimizer may serve the closer area because the same number of units remains unmet either way. The SRS objective leaves unmet demand unweighted, so the implementation applies one penalty to all severity levels. A policy change to severity-weighted unmet demand belongs in the cost of the direct source-to-area arcs." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5E1EB;strokeWidth=2;fontColor=#172B42;fontFamily=Arial;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="505" width="1480" height="119" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="6fd977d23efa" name="Metrics">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="960" as="geometry" />
        </mxCell>
        <mxCell id="3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#173B60;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1600" height="76" as="geometry" />
        </mxCell>
        <mxCell id="4" value="Metrics" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=27;fontColor=#FFFFFF;fontStyle=1;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="15" width="1470" height="47" as="geometry" />
        </mxCell>
        <mxCell id="5" value="Backend and database walkthrough  |  Page 10" style="text;html=1;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#526579;fontStyle=0;fillColor=none;strokeColor=none;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="907" width="1450" height="25" as="geometry" />
        </mxCell>
        <mxCell id="6" value="Metric" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#173B60;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#FFFFFF;fontFamily=Arial;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="118" width="400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="7" value="Calculation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#173B60;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#FFFFFF;fontFamily=Arial;fontSize=14;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="118" width="1080" height="48" as="geometry" />
        </mxCell>
        <mxCell id="8" value="Average response time" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="166" width="400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="9" value="Total unit-minutes divided by number of assigned ambulances" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="166" width="1080" height="48" as="geometry" />
        </mxCell>
        <mxCell id="10" value="Maximum response time" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="214" width="400" height="48" as="geometry" />
        </mxCell>
        <mxCell id="11" value="Longest travel time among the assignments that send units" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F6FA;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="460" y="214" width="1080" height="48" as="geometry" />
        </mxCell>
        <mxCell id="12" value="Demand coverage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6E2EA;strokeWidth=1;fontColor=#172B42;fontFamily=Arial;fontSize=13;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="262" width="400" height="48" as="geometry" />
        </mxCell>
